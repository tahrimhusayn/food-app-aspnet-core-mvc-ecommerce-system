@model Food_App.Models.CreateProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-mustard text-white">
                    <h3 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Create New Product</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="CategoryId" class="form-label">
                                        <i class="fas fa-tags me-1"></i>Category
                                    </label>
                                    <select asp-for="CategoryId" class="form-select" asp-items="Model.CategoryList">
                                        <option value="">Select a category</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Name" class="form-label">
                                        <i class="fas fa-box me-1"></i>Product Name
                                    </label>
                                    <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label">
                                <i class="fas fa-align-left me-1"></i>Description
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter product description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Price" class="form-label">
                                        <i class="fas fa-dollar-sign me-1"></i>Price
                                    </label>
                                    <input asp-for="Price" class="form-control" placeholder="0.00" step="0.01" />
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Stock" class="form-label">
                                        <i class="fas fa-warehouse me-1"></i>Stock Quantity
                                    </label>
                                    <input asp-for="Stock" class="form-control" placeholder="0" min="0" />
                                    <span asp-validation-for="Stock" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Status" class="form-label">
                                        <i class="fas fa-toggle-on me-1"></i>Status
                                    </label>
                                    <select asp-for="Status" class="form-select">
                                        <option value="Active">Active</option>
                                        <option value="Pending">Pending</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ImageUrl" class="form-label">
                                <i class="fas fa-image me-1"></i>Image URL
                            </label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="form-group mb-3">
                                <label asp-for="SellerNumericId" class="form-label">
                                    <i class="fas fa-user me-1"></i>Seller
                                </label>
                                <select asp-for="SellerNumericId" class="form-select" asp-items="Model.SellerList">
                                    <option value="">Select a seller (optional)</option>
                                </select>
                                <span asp-validation-for="SellerNumericId" class="text-danger"></span>
                                <small class="form-text text-muted">Leave empty to assign to yourself</small>
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-mustard">
                                <i class="fas fa-save me-2"></i>Create Product
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
