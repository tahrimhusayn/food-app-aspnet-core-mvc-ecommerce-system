@model IEnumerable<Food_App.Models.Product>

@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-3 fw-bold mb-4">Delicious Food <br><span class="text-warning">Delivered Fast</span></h1>
                <p class="lead mb-4">Discover amazing dishes from local restaurants and food vendors. Order now and get your favorite meals delivered to your doorstep.</p>
                <div class="d-flex gap-3">
                    <a asp-controller="Shopping" asp-action="Index" class="btn btn-light btn-lg px-4">
                        <i class="fas fa-shopping-bag me-2"></i>Order Now
                    </a>
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-4">
                            <i class="fas fa-user-plus me-2"></i>Join Us
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="hero-image">
                    <i class="fas fa-utensils" style="font-size: 200px; color: rgba(255,255,255,0.3);"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="container my-5">
    <div class="row text-center mb-5">
        <div class="col-12">
            <h2 class="display-5 fw-bold mb-3">Why Choose Food App?</h2>
            <p class="lead text-muted">We make ordering food simple, fast, and delicious</p>
        </div>
    </div>
    
    <div class="row g-4">
        <div class="col-md-4">
            <div class="text-center">
                <div class="feature-icon">
                    <i class="fas fa-shipping-fast"></i>
                </div>
                <h4>Fast Delivery</h4>
                <p class="text-muted">Get your food delivered in 30 minutes or less. We prioritize speed without compromising quality.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="text-center">
                <div class="feature-icon">
                    <i class="fas fa-star"></i>
                </div>
                <h4>Quality Food</h4>
                <p class="text-muted">Only the best restaurants and food vendors. Every dish is carefully selected for quality and taste.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="text-center">
                <div class="feature-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <h4>Easy Ordering</h4>
                <p class="text-muted">Simple and intuitive interface. Order your favorite food with just a few clicks.</p>
            </div>
        </div>
    </div>
</div>

<!-- Categories Section -->
<div class="bg-light-mustard py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="display-5 fw-bold mb-3">Popular Categories</h2>
                <p class="lead">Explore our diverse range of food categories</p>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="card stats-card text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-hamburger fa-3x text-primary mb-3"></i>
                        <h5>Fast Food</h5>
                        <p class="text-muted">Burgers, Pizza, Fries & More</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card stats-card text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-coffee fa-3x text-primary mb-3"></i>
                        <h5>Beverages</h5>
                        <p class="text-muted">Drinks, Juices, Coffee & Tea</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card stats-card text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-birthday-cake fa-3x text-primary mb-3"></i>
                        <h5>Desserts</h5>
                        <p class="text-muted">Cakes, Pastries, Ice Cream</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card stats-card text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-leaf fa-3x text-primary mb-3"></i>
                        <h5>Healthy Food</h5>
                        <p class="text-muted">Salads, Smoothies, Organic</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Featured Products Section -->
<div class="container my-5">
    <div class="row text-center mb-5">
        <div class="col-12">
            <h2 class="display-5 fw-bold mb-3">Featured Products</h2>
            <p class="lead text-muted">Check out our most popular dishes</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var product in Model.Take(6))
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 250px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-light-mustard d-flex align-items-center justify-content-center" style="height: 250px;">
                            <i class="fas fa-image fa-4x text-primary"></i>
                        </div>
                    }
                    
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title">@product.Name</h5>
                            <span class="badge bg-primary">@product.Category?.Name</span>
                        </div>
                        <p class="card-text text-muted">@product.Description</p>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="h4 text-primary fw-bold">$@product.Price.ToString("F2")</span>
                                <small class="text-muted"><i class="fas fa-warehouse me-1"></i>@product.Stock in stock</small>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Shopping" asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-outline-primary flex-fill">
                                    <i class="fas fa-eye me-1"></i>View Details
                                </a>
                                @if (User.Identity.IsAuthenticated && !User.IsInRole("Seller") && !User.IsInRole("Admin"))
                                {
                                    <button class="btn btn-primary flex-fill" onclick="addToCart(@product.ProductId, this)">
                                        <i class="fas fa-cart-plus me-1"></i>Add to Cart
                                    </button>
                                }
                                else if (!User.Identity.IsAuthenticated)
                                {
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary flex-fill">
                                        <i class="fas fa-sign-in-alt me-1"></i>Login to Buy
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Count() > 6)
    {
        <div class="text-center mt-5">
            <a asp-controller="Shopping" asp-action="Index" class="btn btn-primary btn-lg px-5">
                <i class="fas fa-arrow-right me-2"></i>View All Products
            </a>
        </div>
    }
</div>

<!-- CTA Section -->
<div class="bg-primary text-white py-5">
    <div class="container text-center">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-5 fw-bold mb-3">Ready to Order?</h2>
                <p class="lead mb-4">Join thousands of satisfied customers who trust us for their daily meals.</p>
                <a asp-controller="Shopping" asp-action="Index" class="btn btn-light btn-lg px-5">
                    <i class="fas fa-shopping-bag me-2"></i>Start Ordering Now
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addToCart(productId, buttonElement) {
            console.log('Adding product to cart:', productId);
            
            fetch('/Shopping/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ productId: productId, quantity: 1 })
            })
            .then(response => {
                console.log('Response status:', response.status);
                console.log('Response headers:', response.headers);
                
                if (!response.ok) {
                    return response.text().then(text => {
                        console.error('Error response:', text);
                        throw new Error(`HTTP ${response.status}: ${text}`);
                    });
                }
                return response.json();
            })
            .then(data => {
                console.log('Success response:', data);
                if (data.success) {
                    // Show success message with better UX
                    const originalText = buttonElement.innerHTML;
                    buttonElement.innerHTML = '<i class="fas fa-check me-1"></i>Added!';
                    buttonElement.classList.remove('btn-primary');
                    buttonElement.classList.add('btn-success');
                    
                    setTimeout(() => {
                        buttonElement.innerHTML = originalText;
                        buttonElement.classList.remove('btn-success');
                        buttonElement.classList.add('btn-primary');
                    }, 2000);
                } else {
                    alert('Error: ' + (data.message || 'Failed to add item to cart'));
                }
            })
            .catch(error => {
                console.error('Detailed error:', error);
                alert('An error occurred while adding to cart: ' + error.message);
            });
        }
    </script>
}
