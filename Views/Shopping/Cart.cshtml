@model Food_App.Models.Cart

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container">
    <h2>Shopping Cart</h2>
    
    @if (Model?.CartItems?.Any() == true)
    {
        <div class="row">
            <div class="col-md-8">
                @foreach (var item in Model.CartItems)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                    {
                                        <img src="@item.Product.ImageUrl" class="img-fluid rounded" alt="@item.Product.Name">
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 80px;">
                                            <i class="fas fa-image text-muted"></i>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <h5>@item.Product.Name</h5>
                                    <p class="text-muted">@item.Product.Category?.Name</p>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Quantity:</label>
                                    <input type="number" class="form-control" value="@item.Quantity" 
                                           min="1" max="@item.Product.Stock" 
                                           onchange="updateQuantity(@item.CartItemId, this.value)">
                                </div>
                                <div class="col-md-2">
                                    <strong>$@item.Product.Price.ToString("F2")</strong>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-danger btn-sm" onclick="removeFromCart(@item.CartItemId)">Remove</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5>Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <span>Subtotal:</span>
                            <span>$@Model.CartItems.Sum(ci => ci.Product.Price * ci.Quantity).ToString("F2")</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between">
                            <strong>Total:</strong>
                            <strong>$@Model.CartItems.Sum(ci => ci.Product.Price * ci.Quantity).ToString("F2")</strong>
                        </div>
                        <a asp-action="Checkout" class="btn btn-primary w-100 mt-3">Proceed to Checkout</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <h4>Your cart is empty</h4>
            <p>Add some products to get started!</p>
            <a asp-action="Index" class="btn btn-primary">Continue Shopping</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateQuantity(cartItemId, quantity) {
            fetch('/Shopping/UpdateCartItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ cartItemId: cartItemId, quantity: parseInt(quantity) })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error updating cart item');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while updating the cart.');
            });
        }

        function removeFromCart(cartItemId) {
            if (confirm('Are you sure you want to remove this item from your cart?')) {
                fetch('/Shopping/RemoveFromCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify({ cartItemId: cartItemId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error removing item from cart');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while removing the item.');
                });
            }
        }
    </script>
}
