@model IEnumerable<Food_App.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">Our Products</h2>
        </div>
    </div>

    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="fas fa-image fa-3x text-muted"></i>
                        </div>
                    }
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text text-muted">@product.Category?.Name</p>
                        <p class="card-text">@product.Description</p>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="h5 text-primary">$@product.Price.ToString("F2")</span>
                                <small class="text-muted">Stock: @product.Stock</small>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm flex-fill">View Details</a>
                                @if (User.Identity.IsAuthenticated && !User.IsInRole("Seller") && !User.IsInRole("Admin"))
                                {
                                    <button class="btn btn-primary btn-sm flex-fill" onclick="addToCart(@product.ProductId)">Add to Cart</button>
                                }
                                else if (!User.Identity.IsAuthenticated)
                                {
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm flex-fill">Login to Buy</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function addToCart(productId) {
            fetch('/Shopping/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ productId: productId, quantity: 1 })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Item added to cart!');
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while adding to cart.');
            });
        }
    </script>
}
