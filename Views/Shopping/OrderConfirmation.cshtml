@model Food_App.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white text-center">
                    <h3><i class="fas fa-check-circle me-2"></i>Order Confirmed!</h3>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h4>Thank you for your order!</h4>
                        <p class="text-muted">Your order has been successfully placed and is being processed.</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5>Order Details</h5>
                            <p><strong>Order ID:</strong> #@Model.OrderId</p>
                            <p><strong>Order Date:</strong> @Model.OrderDate?.ToString("MMM dd, yyyy HH:mm")</p>
                            <p><strong>Status:</strong> <span class="badge bg-warning">@Model.Status</span></p>
                            <p><strong>Total Amount:</strong> $@Model.TotalAmount.ToString("F2")</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Shipping Address</h5>
                            <p>@Model.Address</p>
                        </div>
                    </div>

                    <hr>

                    <h5>Order Items</h5>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>@item.Product.Name</td>
                                        <td>@item.Quantity</td>
                                        <td>$@item.Price.ToString("F2")</td>
                                        <td>$@((item.Price * item.Quantity).ToString("F2"))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3">Total</th>
                                    <th>$@Model.TotalAmount.ToString("F2")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="text-center mt-4">
                        <a asp-controller="Shopping" asp-action="Index" class="btn btn-primary me-2">Continue Shopping</a>
                        <a asp-controller="Shopping" asp-action="OrderHistory" class="btn btn-outline-primary">View Order History</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
