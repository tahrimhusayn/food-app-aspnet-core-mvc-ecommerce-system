@model IEnumerable<Food_App.Models.ApplicationUser>

@{
    ViewData["Title"] = "All Users";
}

<div class="container">
    <h2>All Users</h2>
    
    @if (Model?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Created</th>
                        <th>Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>
                                @{
                                    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
                                    var roles = userRoles?.GetValueOrDefault(user.Id) ?? new List<string>();
                                }
                                @foreach (var role in roles)
                                {
                                    <span class="badge bg-@(role == "Admin" ? "danger" : role == "Seller" ? "warning" : "info")">@role</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>@user.Address</td>
                            <td>
                                <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-edit me-1"></i>Edit
                                </a>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteUser('@user.Id', '@user.FirstName @user.LastName')">
                                    <i class="fas fa-trash me-1"></i>Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center">
            <h4>No users found</h4>
            <p>There are no users in the system yet.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function deleteUser(userId, userName) {
            if (confirm(`Are you sure you want to delete user "${userName}"? This action cannot be undone.`)) {
                fetch('/Dashboard/DeleteUser', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify({ id: userId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('User deleted successfully!');
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while deleting the user.');
                });
            }
        }
    </script>
}
